{
  "name": "@alfredhuang211/dsh-ai-passport",
  "version": "2.0.1",
  "type": "module",
  "description": "AI Passport × DeepSeek Harness 联动插件：BLE 联机、任务新建与选择、执行状态显示、完成提醒、任务审批、DeepSeek 余额、语音输入",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alfredhuang211/dsh-ai-passport.git",
    "directory": "packages/dsh-ai-passport"
  },
  "homepage": "https://github.com/alfredhuang211/dsh-ai-passport/tree/main/packages/dsh-ai-passport#readme",
  "bugs": {
    "url": "https://github.com/alfredhuang211/dsh-ai-passport/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "ai-passport",
    "folotoy",
    "esp32",
    "ble",
    "bluetooth",
    "speech-to-text",
    "voice-input"
  ],
  "main": "lib/index.js",
  "files": [
    "lib",
    "!lib/**/*.test.js",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"lib/**/*.test.js\" \"test/**/*.test.js\""
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <0.3.0 || >=0.2.3-alpha.2 <0.3.0"
  },
  "author": "slinxiaosun-blip",
  "license": "MIT",
  "exports": {
    "./client": "./lib/client.js",
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "publishConfig": {
    "access": "public"
  },
  "icon": "./icon.svg",
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0",
    "@stoprocent/noble": "^2.8.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@stoprocent/noble": {
      "optional": true
    }
  }
}
