# ---------------------------------------------------------------------------
# 本仓库 = DSH 插件 + 设备端固件源码（vendor/ai-passport）+ 跨端文档与工具。
#
# 固件源码通过 subtree merge 从 ai-passport-dsh 历史引入；它自己的 .gitignore
# 仍然生效（构建产物 build/、managed_components/、sdkconfig 等不会入库）。
# 第三方音效采样（main/alert_cough_*.h）也由固件侧 .gitignore 排除。
# ---------------------------------------------------------------------------

# Node
node_modules/
packages/*/node_modules/

# 插件运行时产物（录音临时文件）
packages/dsh-ai-passport/audio/

# 提示音离线试听产物（tools/sound-preview.mjs 生成，不入库）
sound-preview/

# 本地音效采样与生成物（含第三方版权音频，绝不入库）
sound-assets/

# Python
__pycache__/
*.pyc

# 日志
*.log

# macOS
.DS_Store

# 本地会话记忆（WorkBuddy 工作区数据，不入库）
.workbuddy/
